pipeline {
    agent any

    stages {
        stage('pull') {
            steps {
                git 'https://github.com/pranav-khade-tech/Installing-Jenkin-on-Ubuntu.git'
            }
        stage('Build') {
            steps {
                echo 'Building..'
            }
        }
        stage('Test') {
            steps {
                echo 'Testing..'
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploying....'
            }
        }
        stage('test'){
           steps {
                echo 'Testing Done....'
            } 
        }
    }
}