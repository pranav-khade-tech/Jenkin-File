    agent any
    
    stages{
        stage('Pull'){
            steps{
            git 'https://github.com/iamtruptimane/sample-node-file.git'
            }
        }
        stage('apply'){
            steps{
                echo "Apply successfully"
            }
        }
        stage('test'){
            steps{
                echo "test succesfully"
            }
        }
        stage('Build'){
            steps{
                echo "build sucessfully"
            }
        }
    }
}